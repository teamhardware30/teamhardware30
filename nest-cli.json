{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "../views/**/*", "outDir": "dist/views" },
      { "include": "modules/ai/prompts/**/*.md" }
    ],
    "watchAssets": true
  }
}
