NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
SENTRY_DSN=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_copilot
REDIS_URL=redis://localhost:6379

SESSION_SECRET=local-dev-session-secret-change-me-32chars
CSRF_SECRET=local-dev-csrf-secret-change-me-32chars

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-2
EMBEDDING_DIMENSIONS=1024

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=job-copilot-uploads
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
RESUME_MAX_PAGES=20
RESUME_PROCESSING_TIMEOUT_MS=120000

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@job-copilot.local

APPLY_DAILY_LIMIT=25
SCAN_DAILY_LIMIT=20

CRAWLER_CONTACT_EMAIL=crawler@job-copilot.local
CRAWLER_REQUESTS_PER_SECOND=1
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_TIMEOUT_MS=30000
CRAWLER_MAX_RESPONSE_BYTES=5242880
