    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.28.1",
    "msw": "^2.6.6",
    "playwright": "^1.49.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "testcontainers": "^10.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.14.2"
}
