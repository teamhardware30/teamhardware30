{
  "name": "job-copilot",
  "version": "0.1.0",
  "description": "Crawls jobs, builds seeker profiles, matches jobs, scans CVs, and supports one-click apply.",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node src/worker.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "css:build": "tailwindcss -i ./assets/input.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./assets/input.css -o ./public/css/app.css --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@napi-rs/canvas": "^1.0.13",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.3.0",
    "alpinejs": "^3.14.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.0",
    "connect-redis": "^7.1.1",
    "csrf-csrf": "^3.0.3",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "file-type": "^19.6.0",
    "htmx.org": "^2.0.3",
    "ioredis": "^5.4.1",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-openidconnect": "^0.1.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.13.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
