{% extends "layouts/base.njk" %}
{% from "components/badge.njk" import badge %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block head %}
  <meta name="description" content="{{ metaDescription }}" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ metaDescription }}" />
  <meta property="og:url" content="/jobs/{{ job.id }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ metaDescription }}" />
  <link rel="canonical" href="/jobs/{{ job.id }}" />
  <script type="application/ld+json">{{ jsonLd | safe }}</script>
{% endblock %}

{% block content %}
  <div class="mb-6">
    <a href="/jobs" class="text-sm text-brand-text/60 hover:text-brand-primary">← Back to jobs</a>
  </div>

  {% if not job.isActive %}
    <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      This posting is no longer marked active. It may have been filled or removed.
    </div>
  {% endif %}

  <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
    <article>
      <header class="border-b border-brand-text/10 pb-6">
        <h1 class="text-2xl font-semibold leading-tight">{{ job.title }}</h1>
        <p class="mt-2 text-base text-brand-text/70">
          {{ job.company }}
          {% if job.location %}<span class="text-brand-text/40"> · </span>{{ job.location }}{% endif %}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {% if job.remote %}{{ badge('Remote', 'accent') }}{% endif %}
          {% if job.employmentType %}{{ badge(job.employmentType | employmentLabel, 'neutral') }}{% endif %}
          {% if job.category %}{{ badge(job.category.name, 'primary') }}{% endif %}
        </div>
      </header>

      <div class="prose prose-sm mt-6 max-w-none text-brand-text">
        {{ job.descriptionHtml | sanitizeHtml | safe }}
      </div>
    </article>

    <aside class="space-y-5">
      <div class="rounded-lg border border-brand-primary/10 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Job facts</h2>
        <dl class="mt-4 space-y-3 text-sm">
          {% if job.salaryMin or job.salaryMax %}
            <div>
              <dt class="text-brand-text/50">Salary</dt>
              <dd class="font-medium">{{ job.salaryMin | money(job.salaryMax, job.salaryCurrency, job.salaryPeriod) }}</dd>
            </div>
          {% endif %}
          {% if job.location %}
            <div>
              <dt class="text-brand-text/50">Location</dt>
              <dd class="font-medium">{{ job.location }}</dd>
            </div>
          {% endif %}
          {% if job.employmentType %}
            <div>
              <dt class="text-brand-text/50">Employment type</dt>
              <dd class="font-medium">{{ job.employmentType | employmentLabel }}</dd>
            </div>
          {% endif %}
          <div>
            <dt class="text-brand-text/50">Posted</dt>
            <dd class="font-medium">{{ (job.postedAt or job.createdAt) | timeAgo }}</dd>
          </div>
          {% if job.source %}
            <div>
              <dt class="text-brand-text/50">Source</dt>
              <dd class="font-medium">{{ job.source.name }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>

      <div class="rounded-lg border border-brand-primary/10 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Apply</h2>
        {% if job.applyMethod == 'onsite' %}
          <button
            type="button"
            disabled
            class="mt-3 w-full cursor-not-allowed rounded-md bg-brand-primary/40 px-4 py-2 text-sm font-medium text-white"
          >
            Apply on Job Copilot — coming soon
          </button>
        {% elif job.applyMethod == 'email' and job.applyEmail %}
          <a
            href="mailto:{{ job.applyEmail }}?subject={{ ('Application: ' + job.title) | urlencode }}"
            class="mt-3 block w-full rounded-md bg-brand-primary px-4 py-2 text-center text-sm font-medium text-white hover:bg-brand-primary/90"
          >
            Apply by email
          </a>
        {% elif job.applyUrl %}
          <a
            href="{{ job.applyUrl }}"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="mt-3 block w-full rounded-md bg-brand-primary px-4 py-2 text-center text-sm font-medium text-white hover:bg-brand-primary/90"
          >
            Apply on company site
          </a>
        {% else %}
          <button
            type="button"
            disabled
            class="mt-3 w-full cursor-not-allowed rounded-md bg-brand-primary/40 px-4 py-2 text-sm font-medium text-white"
          >
            Apply — coming soon
          </button>
        {% endif %}
        {% if job.sourceUrl %}
          <a href="{{ job.sourceUrl }}" target="_blank" rel="noopener noreferrer nofollow" class="mt-3 block text-center text-xs text-brand-text/50 hover:text-brand-primary">
            View original posting
          </a>
        {% endif %}
      </div>
    </aside>
  </div>
{% endblock %}
