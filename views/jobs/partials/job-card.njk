{% from "components/badge.njk" import badge %}
<article class="rounded-lg border border-brand-primary/10 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <a href="/jobs/{{ job.id }}" class="text-lg font-semibold text-brand-text hover:text-brand-primary">{{ job.title }}</a>
      <p class="mt-1 text-sm text-brand-text/70">
        {{ job.company }}
        {% if job.location %}<span class="text-brand-text/40"> · </span>{{ job.location }}{% endif %}
      </p>
    </div>
    {% if job.postedAt %}
      <span class="shrink-0 text-xs text-brand-text/50">{{ job.postedAt | timeAgo }}</span>
    {% endif %}
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    {% if job.remote %}{{ badge('Remote', 'accent') }}{% endif %}
    {% if job.employmentType %}{{ badge(job.employmentType | employmentLabel, 'neutral') }}{% endif %}
    {% if job.category %}{{ badge(job.category.name, 'primary') }}{% endif %}
  </div>

  {% if job.salaryMin or job.salaryMax %}
    <p class="mt-3 text-sm font-medium text-brand-primary">
      {{ job.salaryMin | money(job.salaryMax, job.salaryCurrency, job.salaryPeriod) }}
    </p>
  {% endif %}

  <p class="mt-2 text-sm leading-relaxed text-brand-text/70">{{ job.descriptionText | truncate(200) }}</p>
</article>
