{% extends "layouts/base.njk" %}
{% block title %}Job categories — Job Copilot{% endblock %}
{% block content %}
  <h1 class="text-2xl font-semibold">Job categories</h1>
  <p class="mt-2 text-sm text-brand-text/60">Browse active jobs by family and subcategory.</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for family in categories %}
      <section class="rounded-lg border border-brand-text/10 bg-white p-4">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-brand-text">{{ family.name }}</h2>
          <a href="/jobs?category={{ family.slug }}" class="text-sm text-brand-primary hover:underline">{{ family.count }} jobs</a>
        </div>
        <ul class="mt-3 space-y-1 text-sm">
          {% for child in family.children %}
            <li class="flex items-center justify-between">
              <a href="/jobs?category={{ child.slug }}" class="text-brand-text/70 hover:text-brand-primary">{{ child.name }}</a>
              <span class="text-xs text-brand-text/50">{{ child.count }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
{% endblock %}
