{% extends "layouts/base.njk" %}

{% block title %}Sources — Job Copilot{% endblock %}

{% block content %}
  <div class="flex items-baseline justify-between">
    <div>
      <h1 class="text-xl font-semibold">Crawl sources</h1>
      <p class="mt-1 text-sm text-brand-text/60">Enable sources, trigger a crawl, and review the last run.</p>
    </div>
    <a href="/admin/crawl-runs" class="text-sm font-medium text-brand-primary hover:underline">Crawl runs →</a>
  </div>

  <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {% for label, key in [['Active', 'active'], ['Inactive', 'inactive'], ['Expired', 'expired'], ['Stale (45+ days)', 'stale']] %}
      <div class="rounded-lg border border-brand-primary/10 bg-white p-4">
        <dt class="text-xs uppercase tracking-wide text-brand-text/50">{{ label }}</dt>
        <dd class="mt-1 text-2xl font-semibold">{{ metrics[key] }}</dd>
      </div>
    {% endfor %}
  </dl>

  <div class="mt-6">
    {% include "admin/partials/sources.njk" %}
  </div>
{% endblock %}
