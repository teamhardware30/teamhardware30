{% from "components/badge.njk" import badge %}
<div id="sources-table">
  {% if message %}
    <div class="mb-4 rounded-md border border-brand-primary/20 bg-brand-primary/5 px-4 py-3 text-sm text-brand-text">
      {{ message }}
    </div>
  {% endif %}

  <div class="overflow-x-auto rounded-lg border border-brand-primary/10 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-brand-text/10 text-sm">
      <thead class="bg-brand-bg/60 text-left text-xs uppercase tracking-wide text-brand-text/60">
        <tr>
          <th class="px-4 py-3 font-medium">Source</th>
          <th class="px-4 py-3 font-medium">Kind / schedule</th>
          <th class="px-4 py-3 font-medium">Last run and errors</th>
          <th class="px-4 py-3 font-medium">Controls</th>
          <th class="px-4 py-3 text-right font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-text/5">
        {% for source in sources %}
          <tr>
            <td class="px-4 py-3 align-top">
              <p class="font-medium text-brand-text">{{ source.name }}</p>
              <p class="mt-0.5 max-w-xs truncate text-xs text-brand-text/50">{{ source.baseUrl }}</p>
              {% if source.killSwitch %}<p class="mt-2">{{ badge('Traffic stopped', 'danger') }}</p>{% endif %}
            </td>
            <td class="px-4 py-3 align-top">
              {{ badge(source.kind, 'neutral') }}
              <p class="mt-2 font-mono text-xs text-brand-text/70">{{ source.cron }}</p>
            </td>
            <td class="px-4 py-3 align-top">
              {% if source.latestRun %}
                {% set run = source.latestRun %}
                <p class="text-brand-text/70">{{ run.startedAt | timeAgo }}</p>
                <p class="mt-1">
                  {% if run.status == 'success' %}{{ badge('success', 'success') }}
                  {% elif run.status == 'failed' %}{{ badge('failed', 'danger') }}
                  {% elif run.status == 'running' %}{{ badge('running', 'primary') }}
                  {% else %}{{ badge(run.status, 'warning') }}{% endif %}
                </p>
                <p class="mt-1 text-xs text-brand-text/60">
                  {{ run.jobsFound }} found · {{ run.jobsCreated }} new · {{ run.jobsUpdated }} changed · {{ run.jobsSkipped }} skipped
                </p>
                <p class="mt-1 text-xs text-brand-text/50">{{ run.batchesCompleted }}/{{ run.batchesTotal }} batches complete</p>
                {% if run.errorCount > 0 %}
                  <details class="mt-2 max-w-sm text-xs text-red-700">
                    <summary class="cursor-pointer">{{ run.errorCount }} item error{{ '' if run.errorCount == 1 else 's' }}</summary>
                    <ul class="mt-1 space-y-1">
                      {% for item in run.errors.slice(0, 5) %}
                        <li><strong>{{ item.stage }}</strong>: {{ item.reason }}{% if item.sourceUrl %} — {{ item.sourceUrl }}{% endif %}</li>
                      {% endfor %}
                    </ul>
                  </details>
                {% elif run.error %}
                  <p class="mt-1 max-w-xs truncate text-xs text-red-700" title="{{ run.error }}">{{ run.error }}</p>
                {% endif %}
              {% else %}
                <span class="text-brand-text/40">Never</span>
                {% if source.lastRunMessage %}<p class="mt-1 text-xs text-red-700">{{ source.lastRunMessage }}</p>{% endif %}
              {% endif %}
            </td>
            <td class="px-4 py-3 align-top">
              <div class="flex flex-col items-start gap-2">
                <button
                  type="button"
                  hx-patch="/admin/sources/{{ source.id }}/toggle"
                  hx-target="#sources-table"
                  hx-swap="outerHTML"
                  class="inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-xs font-medium {{ 'bg-green-100 text-green-800' if source.enabled else 'bg-brand-text/10 text-brand-text/60' }}"
                >
                  {{ 'Enabled' if source.enabled else 'Disabled' }}
                </button>
                <button
                  type="button"
                  hx-patch="/admin/sources/{{ source.id }}/kill-switch"
                  hx-target="#sources-table"
                  hx-swap="outerHTML"
                  class="rounded-md border px-2.5 py-1 text-xs font-medium {{ 'border-red-300 text-red-700' if not source.killSwitch else 'border-green-300 text-green-700' }}"
                >
                  {{ 'Engage kill switch' if not source.killSwitch else 'Release kill switch' }}
                </button>
              </div>
            </td>
            <td class="px-4 py-3 text-right align-top">
              <button
                type="button"
                hx-post="/admin/sources/{{ source.id }}/run"
                hx-target="#sources-table"
                hx-swap="outerHTML"
                hx-disabled-elt="this"
                {% if source.killSwitch %}disabled{% endif %}
                class="rounded-md border border-brand-primary/20 px-3 py-1.5 text-xs font-medium text-brand-primary hover:bg-brand-primary/5 disabled:cursor-not-allowed disabled:opacity-50"
              >
                Run now
              </button>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="px-4 py-10 text-center text-brand-text/60">
              No sources yet. Add them to <code>sources.yaml</code> and run <code>pnpm db:seed:sources</code>.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
