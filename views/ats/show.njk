{% extends "layouts/base.njk" %}
{% from "components/score_ring.njk" import score_ring %}
{% block title %}ATS scan — Job Copilot{% endblock %}
{% block content %}
  <div class="mx-auto max-w-3xl space-y-6">
    <div class="flex items-center gap-4">
      {{ score_ring(scan.score) }}
      <div>
        <h1 class="text-2xl font-semibold">ATS score: {{ scan.score }}/100</h1>
        <p class="text-sm text-brand-text/60">Resume {{ scan.resumeId }}{% if scan.jobId %} · Job {{ scan.jobId }}{% endif %}</p>
      </div>
    </div>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Checklist</h2>
      <ul class="mt-3 space-y-2">
        {% for issue in scan.formatIssues %}
          <li class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{ issue.message }} <span class="text-xs">Fix: {{ issue.fix }}</span></li>
        {% else %}
          <li class="rounded-md border border-brand-primary/20 bg-brand-primary/10 px-3 py-2 text-sm text-brand-primary">All deterministic checks passed.</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Keyword hits</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {% for hit in scan.keywordHits %}<span class="rounded-full bg-brand-primary/10 px-3 py-1 text-xs text-brand-primary">{{ hit.keyword }} · {{ hit.section }}</span>{% endfor %}
      </div>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Keyword gaps</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {% for gap in scan.keywordGaps %}<span class="rounded-full bg-red-50 px-3 py-1 text-xs text-red-700">{{ gap.keyword }}</span>{% endfor %}
      </div>
    </section>

    {% if scan.suggestions and scan.suggestions[0] %}
      <section>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Bullet rewrites</h2>
        <div class="mt-3 space-y-3">
          {% for rewrite in scan.suggestions[0].bulletRewrites %}
            <div class="rounded-md border border-brand-text/10 bg-white p-3 text-sm">
              <p class="text-brand-text/60">Original: {{ rewrite.original }}</p>
              <p class="mt-1 font-medium">Improved: {{ rewrite.improved }}</p>
              <p class="mt-1 text-xs text-brand-text/50">{{ rewrite.why }}</p>
            </div>
          {% endfor %}
        </div>
        {% if scan.suggestions[0].summary_rewrite %}
          <p class="mt-4 text-sm text-brand-text/70">{{ scan.suggestions[0].summary_rewrite }}</p>
        {% endif %}
      </section>
    {% endif %}

    <form method="post" action="/ats/scans/{{ scan.id }}/tailor" hx-post="/ats/scans/{{ scan.id }}/tailor" hx-target="#tailor-result" hx-swap="innerHTML">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <button type="submit" class="rounded-md bg-brand-primary px-4 py-2 text-sm text-white hover:bg-brand-primary/90">Create tailored copy</button>
    </form>
    <div id="tailor-result"></div>
  </div>
{% endblock %}
