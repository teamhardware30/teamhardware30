{% extends "layouts/base.njk" %}
{% from "components/card.njk" import card %}
{% from "components/badge.njk" import badge %}
{% from "components/score_ring.njk" import score_ring %}

{% block title %}Job Copilot — Find your next role faster{% endblock %}

{% block content %}
  <div class="grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-2 lg:gap-12">
    <div class="text-center lg:text-left">
      {{ badge("AI-powered job search", "accent") }}
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-brand-text sm:text-5xl">
        Your AI co-pilot for the job search
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base text-brand-text/70 sm:text-lg lg:mx-0">
        Job Copilot builds your profile from your CV, matches you to roles, scores your fit like an ATS, and applies for you.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        {% if user %}
          <a href="/profile" class="w-full rounded-md bg-brand-primary px-6 py-3 text-center text-sm font-semibold text-white shadow-sm hover:bg-brand-primary/90 sm:w-auto">Go to your profile</a>
        {% else %}
          <a href="/register" class="w-full rounded-md bg-brand-primary px-6 py-3 text-center text-sm font-semibold text-white shadow-sm hover:bg-brand-primary/90 sm:w-auto">Get started free</a>
          <a href="/login" class="text-sm font-medium text-brand-text/70 hover:text-brand-primary">Already have an account? Sign in</a>
        {% endif %}
      </div>
      <p class="mt-3 text-xs text-brand-text/50">No credit card required · Set up your profile in minutes</p>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <img
        src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?auto=format&fit=crop&w=1200&q=80"
        alt="A job seeker reviewing matched roles on a laptop"
        class="aspect-[4/3] w-full rounded-xl object-cover shadow-lg"
        width="1200" height="900"
      />
      <div class="absolute -bottom-6 -left-4 flex items-center gap-3 rounded-lg border border-brand-primary/10 bg-white p-3 shadow-md sm:-left-8 sm:p-4">
        {{ score_ring(87, 48) }}
        <div>
          <p class="text-sm font-medium text-brand-text">Senior Backend Engineer</p>
          <p class="text-xs text-brand-text/60">Strong match</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-4 py-10 sm:grid-cols-3">
    {% call card() %}
      <p class="text-2xl font-semibold text-brand-primary">1,000s</p>
      <p class="mt-1 text-sm text-brand-text/70">of jobs crawled daily across the web</p>
    {% endcall %}
    {% call card() %}
      <p class="text-2xl font-semibold text-brand-primary">&lt; 5 min</p>
      <p class="mt-1 text-sm text-brand-text/70">to build your profile from an existing CV</p>
    {% endcall %}
    {% call card() %}
      <p class="text-2xl font-semibold text-brand-primary">1-click</p>
      <p class="mt-1 text-sm text-brand-text/70">apply once a match looks right</p>
    {% endcall %}
  </div>

  <div class="py-10">
    <h2 class="text-center text-2xl font-semibold text-brand-text">How it works</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {% call card() %}
        {{ badge("Step 1", "neutral") }}
        <p class="mt-3 font-medium text-brand-text">Import your CV</p>
        <p class="mt-1 text-sm text-brand-text/70">Upload a CV or LinkedIn export and we'll build a structured profile for you.</p>
      {% endcall %}
      {% call card() %}
        {{ badge("Step 2", "neutral") }}
        <p class="mt-3 font-medium text-brand-text">We crawl the web</p>
        <p class="mt-1 text-sm text-brand-text/70">Fresh listings are pulled in continuously from job boards and company sites.</p>
      {% endcall %}
      {% call card() %}
        {{ badge("Step 3", "neutral") }}
        <p class="mt-3 font-medium text-brand-text">Get matched &amp; scored</p>
        <p class="mt-1 text-sm text-brand-text/70">Every role is ranked against your profile and scored like an ATS would.</p>
      {% endcall %}
      {% call card() %}
        {{ badge("Step 4", "neutral") }}
        <p class="mt-3 font-medium text-brand-text">Apply in one click</p>
        <p class="mt-1 text-sm text-brand-text/70">Review your top matches and submit tailored applications instantly.</p>
      {% endcall %}
    </div>
  </div>

  <div class="py-10">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <img
        src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=1200&q=80"
        alt="Two people shaking hands after a successful interview"
        class="aspect-[4/3] w-full rounded-xl object-cover shadow-lg lg:order-2"
        width="1200" height="900"
      />
      <div class="lg:order-1">
        <h2 class="text-2xl font-semibold text-brand-text">Know your fit before you apply</h2>
        <p class="mt-3 text-brand-text/70">
          Job Copilot scores every match the way an applicant tracking system would, so you can focus on the roles
          where you're most likely to land an interview.
        </p>
        <ul class="mt-4 space-y-3 text-sm text-brand-text/70">
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.415l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415L8.5 12.085l6.793-6.793a1 1 0 011.411-.002z" clip-rule="evenodd" />
            </svg>
            Keyword and skill coverage against the job description
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.415l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415L8.5 12.085l6.793-6.793a1 1 0 011.411-.002z" clip-rule="evenodd" />
            </svg>
            Gaps you can fix before you submit
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.415l-7.5 7.5a1 1 0 01-1.415 0l-3.5-3.5a1 1 0 111.415-1.415L8.5 12.085l6.793-6.793a1 1 0 011.411-.002z" clip-rule="evenodd" />
            </svg>
            Ranked matches so you spend time on the best fits
          </li>
        </ul>
      </div>
    </div>
  </div>

  {% if not user %}
    <div class="my-12 rounded-xl bg-brand-primary px-6 py-12 text-center sm:px-12">
      <h2 class="text-2xl font-semibold text-white">Ready to find your next role?</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-white/80">
        Create your free profile and start getting matched to jobs today.
      </p>
      <div class="mt-6">
        <a href="/register" class="inline-block rounded-md bg-white px-6 py-3 text-sm font-semibold text-brand-primary shadow-sm hover:bg-white/90">Get started free</a>
      </div>
    </div>
  {% endif %}
{% endblock %}
