{% extends "layouts/base.njk" %}
{% block title %}Job Copilot — Find your next role faster{% endblock %}
{% block content %}
  <div class="py-16 text-center">
    <h1 class="text-3xl font-semibold text-brand-text sm:text-4xl">Your AI co-pilot for the job search</h1>
    <p class="mx-auto mt-4 max-w-xl text-brand-text/70">
      Job Copilot builds your profile from your CV, matches you to roles, scores your fit like an ATS, and applies for you.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      {% if user %}
        <a href="/profile" class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-primary/90">Go to your profile</a>
      {% else %}
        <a href="/register" class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-primary/90">Get started free</a>
        <a href="/login" class="rounded-md border border-brand-text/20 px-5 py-2.5 text-sm font-medium hover:bg-brand-text/5">Sign in</a>
      {% endif %}
    </div>
  </div>
{% endblock %}
