{% macro toast(type, message) %}
  {% set tones = {
    "success": "bg-brand-primary/10 text-brand-primary border-brand-primary/20",
    "error": "bg-red-50 text-red-700 border-red-200",
    "info": "bg-brand-accent/10 text-brand-text border-brand-accent/30"
  } %}
  <div
    class="flex items-start justify-between gap-3 rounded-md border px-4 py-3 text-sm {{ tones[type] or tones.info }}"
    role="{{ 'alert' if type == 'error' else 'status' }}"
    x-data="{ show: true }"
    x-show="show"
    x-init="setTimeout(() => { show = false }, 6000)"
  >
    <span>{{ message }}</span>
    <button type="button" class="rounded-sm text-current opacity-70 hover:opacity-100" aria-label="Dismiss notification" @click="show = false">&times;</button>
  </div>
{% endmacro %}
