{% macro select(name, options, opts={}) %}
  <div class="flex flex-col gap-1">
    {% if opts.label %}
      <label for="{{ name }}" class="text-sm font-medium text-brand-text">{{ opts.label }}</label>
    {% endif %}
    <select
      id="{{ name }}"
      name="{{ name }}"
      {% if opts.attrs %}{{ opts.attrs | safe }}{% endif %}
      class="rounded-md border border-brand-text/20 bg-white px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary"
    >
      {% for option in options %}
        <option value="{{ option.value }}" {% if option.value == opts.selected %}selected{% endif %}>{{ option.label }}</option>
      {% endfor %}
    </select>
  </div>
{% endmacro %}
