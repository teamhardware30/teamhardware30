{% macro score_ring(score, size=64) %}
  {% set circumference = 2 * 3.14159 * 28 %}
  {% set offset = circumference - (score / 100) * circumference %}
  {% set tone = '#166534' if score >= 80 else ('#d97706' if score >= 60 else '#64748b') %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 64 64" class="shrink-0" role="img" aria-label="Score {{ score }} out of 100">
    <circle cx="32" cy="32" r="28" fill="none" stroke="#17211b1a" stroke-width="6" />
    <circle
      cx="32" cy="32" r="28" fill="none" stroke="{{ tone }}" stroke-width="6"
      stroke-dasharray="{{ circumference }}" stroke-dashoffset="{{ offset }}"
      stroke-linecap="round" transform="rotate(-90 32 32)"
    />
    <text x="32" y="37" text-anchor="middle" font-size="16" font-weight="600" fill="#17211b">{{ score }}</text>
  </svg>
{% endmacro %}
