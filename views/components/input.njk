{% macro input(name, opts={}) %}
  <div class="flex flex-col gap-1">
    {% if opts.label %}
      <label for="{{ name }}" class="text-sm font-medium text-brand-text">{{ opts.label }}</label>
    {% endif %}
    <input
      type="{{ opts.type or 'text' }}"
      id="{{ name }}"
      name="{{ name }}"
      value="{{ opts.value or '' }}"
      placeholder="{{ opts.placeholder or '' }}"
      {% if opts.required %}required{% endif %}
      {% if opts.attrs %}{{ opts.attrs | safe }}{% endif %}
      class="rounded-md border border-brand-text/20 bg-white px-3 py-2 text-sm focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary {{ 'border-red-500' if opts.error }}"
    />
    {% if opts.error %}
      <p class="text-xs text-red-600">{{ opts.error }}</p>
    {% endif %}
  </div>
{% endmacro %}
