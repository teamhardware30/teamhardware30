{% macro pagination(page, totalPages, baseHref) %}
  {% if totalPages > 1 %}
    <nav class="flex items-center justify-center gap-2 text-sm">
      {% for i in range(1, totalPages + 1) %}
        <a
          href="{{ baseHref }}?page={{ i }}"
          class="rounded-md px-3 py-1.5 {{ 'bg-brand-primary text-white' if i == page else 'text-brand-text/70 hover:bg-brand-primary/10' }}"
        >{{ i }}</a>
      {% endfor %}
    </nav>
  {% endif %}
{% endmacro %}
