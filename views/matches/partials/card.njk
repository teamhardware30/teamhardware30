{% from "components/score_ring.njk" import score_ring %}
{% from "components/badge.njk" import badge %}
<article id="match-{{ match.id }}" class="rounded-lg border border-brand-text/10 bg-white p-4">
  <div class="flex gap-4">
    {{ score_ring(match.score) }}
    <div class="min-w-0 flex-1">
      <h2 class="font-semibold text-brand-text">{{ match.job.title }}</h2>
      <p class="text-sm text-brand-text/60">{{ match.job.company }} · {{ match.job.location or "Remote" }}</p>
      <p class="mt-1 text-xs text-brand-text/50">Posted {{ match.job.postedAt | timeAgo }}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <form method="post" action="/matches/{{ match.id }}/status" hx-patch="/matches/{{ match.id }}/status" hx-vals='{"status":"saved"}' hx-target="#match-{{ match.id }}" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="status" value="saved" />
          <button type="submit" class="text-sm text-brand-primary hover:underline">Save</button>
        </form>
        <form method="post" action="/matches/{{ match.id }}/status" hx-patch="/matches/{{ match.id }}/status" hx-vals='{"status":"hidden"}' hx-target="#match-{{ match.id }}" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="status" value="hidden" />
          <button type="submit" class="text-sm text-red-600 hover:underline">Hide</button>
        </form>
        <a href="/jobs/{{ match.job.id }}" class="text-sm text-brand-primary hover:underline">View job</a>
      </div>
    </div>
  </div>
</article>
