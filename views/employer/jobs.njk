{% extends "layouts/base.njk" %}
{% block title %}Employer jobs — Job Copilot{% endblock %}
{% block content %}
  <h1 class="text-2xl font-semibold">Employer jobs</h1>
  <a href="/employer/jobs/new" class="mt-4 inline-block rounded-md bg-brand-primary px-4 py-2 text-sm text-white">New onsite job</a>
  <ul class="mt-6 space-y-2">
    {% for job in jobs %}<li>{{ job.title }} — {{ job.company }}</li>{% endfor %}
  </ul>
{% endblock %}
