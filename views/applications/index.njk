{% extends "layouts/base.njk" %}
{% block title %}Application tracker — Job Copilot{% endblock %}
{% block content %}
  <h1 class="text-2xl font-semibold">Application tracker</h1>
  <div class="mt-6 grid gap-4 md:grid-cols-5" id="kanban">
    {% for status in ['draft','submitted','interview','offer','rejected'] %}
      <section class="rounded-lg border border-brand-text/10 bg-white p-3" data-status="{{ status }}">
        <h2 class="text-sm font-semibold uppercase">{{ status }}</h2>
        <div class="mt-3 space-y-2 kanban-column" data-status="{{ status }}">
          {% for app in grouped[status] %}
            <article class="rounded-md border border-brand-text/10 bg-brand-bg p-3 text-sm" data-id="{{ app.id }}">
              <p class="font-medium">{{ app.job.title }}</p>
              <p class="text-xs text-brand-text/60">{{ app.job.company }}</p>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
  <script src="/vendor/sortable/Sortable.min.js" defer></script>
  <script nonce="{{ cspNonce }}">
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.kanban-column').forEach((column) => {
        new Sortable(column, {
          group: 'applications',
          onEnd: (event) => {
            const id = event.item.dataset.id;
            const status = event.to.dataset.status;
            if (!id || !status) return;
            fetch(`/applications/${id}/status`, {
              method: 'PATCH',
              headers: { 'x-csrf-token': '{{ csrfToken }}', 'Content-Type': 'application/json' },
              body: JSON.stringify({ status }),
            });
          },
        });
      });
    });
  </script>
{% endblock %}
