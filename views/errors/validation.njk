{% extends "layouts/base.njk" %}
{% block title %}Check your input — Job Copilot{% endblock %}
{% block content %}
  <div class="mx-auto max-w-md rounded-lg border border-red-200 bg-red-50 p-6">
    <h1 class="text-lg font-semibold text-red-700">Please fix the following</h1>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-red-700">
      {% for field, message in fieldErrors %}
        <li>{{ message }}</li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}
