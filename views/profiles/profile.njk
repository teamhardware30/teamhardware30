{% extends "layouts/base.njk" %}
{% block title %}Your profile — Job Copilot{% endblock %}
{% block content %}
  <div class="mx-auto max-w-3xl space-y-10">
    <div id="profile-summary">{% include "profiles/partials/profile-summary.njk" %}</div>

    {% if profile.onboardingStep < 3 %}
      <div class="rounded-md border border-brand-primary/20 bg-brand-primary/10 p-4 text-sm">
        Your onboarding is not complete. <a href="/onboarding" class="font-medium text-brand-primary underline">Continue onboarding</a>.
      </div>
    {% endif %}

    {% set embedded = true %}
    {% set returnTo = '/profile' %}
    {% include "profiles/partials/onboarding-step-3.njk" %}

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Job preferences</h2>
      <div id="profile-preferences">
        {% set preferencesAction = '/profile/preferences' %}
        {% set preferencesTarget = '#profile-preferences' %}
        {% set buttonLabel = 'Save preferences' %}
        {% include "profiles/partials/onboarding-step-4.njk" %}
      </div>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-text/60">Resumes</h2>
      <div class="mt-3">{% include "profiles/partials/resumes-list.njk" %}</div>
      <form
        method="post"
        action="/profile/resumes"
        enctype="multipart/form-data"
        class="mt-3 space-y-2"
        hx-post="/profile/resumes"
        hx-target="#resumes-list"
        hx-swap="outerHTML"
        hx-encoding="multipart/form-data"
      >
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <label for="profile-resume" class="text-sm font-medium">Upload and parse another resume</label>
        <input id="profile-resume" type="file" name="resume" accept=".pdf,.docx,.zip" required class="block text-sm" />
        {% if fieldErrors.resume %}<p class="text-xs text-red-600">{{ fieldErrors.resume }}</p>{% endif %}
        <button type="submit" class="rounded-md bg-brand-primary px-3 py-1.5 text-sm text-white hover:bg-brand-primary/90">Upload and parse</button>
      </form>
    </section>
  </div>
{% endblock %}
