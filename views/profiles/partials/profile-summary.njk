{% from "components/input.njk" import input %}
{% from "components/button.njk" import button %}
{% from "components/badge.njk" import badge %}

<div>
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-brand-text">{{ profile.headline or "Add a headline" }}</h1>
    {{ badge(profile.parseStatus, "neutral") }}
  </div>
  <p class="mt-2 text-sm text-brand-text/70">{{ profile.summary or "No summary yet." }}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {% for ps in profile.profileSkills %}
      {{ badge(ps.skill.name) }}
    {% endfor %}
  </div>

  <details class="mt-6">
    <summary class="cursor-pointer text-sm text-brand-primary">Edit headline & summary</summary>
    <form class="mt-3 space-y-3" hx-post="/profile" hx-target="#profile-summary" hx-swap="outerHTML">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      {{ input("headline", { label: "Headline", value: profile.headline }) }}
      <div class="flex flex-col gap-1">
        <label for="summary" class="text-sm font-medium text-brand-text">Summary</label>
        <textarea name="summary" id="summary" rows="4" class="rounded-md border border-brand-text/20 bg-white px-3 py-2 text-sm">{{ profile.summary or "" }}</textarea>
      </div>
      {{ button("Save", { type: "submit" }) }}
    </form>
  </details>
</div>
