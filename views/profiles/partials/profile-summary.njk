{% from "components/input.njk" import input %}
{% from "components/textarea.njk" import textarea %}
{% from "components/button.njk" import button %}
{% from "components/badge.njk" import badge %}
{% from "components/checkbox.njk" import checkbox %}
{% set form = values or profile %}

<div>
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-xl font-semibold text-brand-text">{{ profile.headline or "Add a headline" }}</h1>
    {{ badge(profile.parseStatus, "neutral") }}
  </div>
  <p class="mt-2 text-sm text-brand-text/70">{{ profile.summary or "No summary yet." }}</p>
  {% if profile.location %}<p class="mt-1 text-sm text-brand-text/60">{{ profile.location }}</p>{% endif %}
  {% if completeness is defined %}
    <div class="mt-4" aria-label="Profile completeness {{ completeness }} percent">
      <progress class="h-2 w-full accent-brand-primary" value="{{ completeness }}" max="100">{{ completeness }}%</progress>
      <p class="mt-1 text-xs text-brand-text/60">{{ completeness }}% complete</p>
    </div>
  {% endif %}
  <div class="mt-4 flex flex-wrap gap-2">
    {% for ps in profile.profileSkills %}{{ badge(ps.skill.name) }}{% endfor %}
  </div>

  <details class="mt-6" {% if fieldErrors %}open{% endif %}>
    <summary class="cursor-pointer text-sm text-brand-primary">Edit profile details</summary>
    <form method="post" action="/profile" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2" hx-post="/profile" hx-target="#profile-summary" hx-swap="outerHTML">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      {{ input("headline", { label: "Headline", value: form.headline, error: fieldErrors.headline }) }}
      {{ input("location", { label: "Location", value: form.location, error: fieldErrors.location }) }}
      <div class="sm:col-span-2">{{ textarea("summary", { label: "Summary", value: form.summary, error: fieldErrors.summary, rows: 4 }) }}</div>
      {{ input("yearsExperience", { label: "Years of experience", type: "number", value: form.yearsExperience, error: fieldErrors.yearsExperience }) }}
      <div class="flex flex-col gap-1">
        <label for="seniority" class="text-sm font-medium text-brand-text">Seniority</label>
        <select id="seniority" name="seniority" class="rounded-md border border-brand-text/20 bg-white px-3 py-2 text-sm">
          <option value="">Not set</option>
          {% for value in seniorityValues %}<option value="{{ value }}" {% if form.seniority == value %}selected{% endif %}>{{ value }}</option>{% endfor %}
        </select>
        {% if fieldErrors.seniority %}<p class="text-xs text-red-600">{{ fieldErrors.seniority }}</p>{% endif %}
      </div>
      <div class="sm:col-span-2">{{ checkbox("openToRelocate", "Open to relocation", { checked: form.openToRelocate }) }}</div>
      <div class="sm:col-span-2">{{ button("Save profile", { type: "submit" }) }}</div>
    </form>
  </details>
</div>
