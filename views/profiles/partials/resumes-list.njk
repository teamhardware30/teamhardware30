<div id="resumes-list" class="space-y-2">
  {% for resume in resumes %}
    <div class="flex items-center justify-between rounded-md border border-brand-text/10 bg-white p-3">
      <div class="text-sm">
        <p class="font-medium text-brand-text">{{ resume.fileName }}</p>
        <p class="text-xs text-brand-text/50">{{ (resume.sizeBytes / 1024) | round }} KB</p>
      </div>
      <div class="flex items-center gap-3 text-xs">
        {% if resume.isPrimary %}
          <span class="rounded-full bg-brand-primary/10 px-2 py-1 font-medium text-brand-primary">Primary</span>
        {% else %}
          <button
            type="button"
            hx-post="/profile/resumes/{{ resume.id }}/primary"
            hx-target="#resumes-list"
            hx-swap="outerHTML"
            class="text-brand-primary hover:underline"
          >Make primary</button>
        {% endif %}
        <button
          type="button"
          hx-delete="/profile/resumes/{{ resume.id }}"
          hx-target="#resumes-list"
          hx-swap="outerHTML"
          class="text-red-600 hover:underline"
        >Remove</button>
      </div>
    </div>
  {% else %}
    <p class="text-sm text-brand-text/50">No resumes uploaded yet.</p>
  {% endfor %}
</div>
