<div id="resumes-list" class="space-y-3">
  {% for resume in resumes %}
    <article class="rounded-md border border-brand-text/10 bg-white p-3">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="text-sm">
          <p class="font-medium text-brand-text">{{ resume.fileName }}</p>
          <p class="text-xs text-brand-text/50">{{ (resume.sizeBytes / 1024) | round }} KB{% if resume.parseStatus %} · {{ resume.parseStatus }}{% endif %}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs">
          {% if resume.isPrimary %}<span class="rounded-full bg-brand-primary/10 px-2 py-1 font-medium text-brand-primary">Primary</span>{% endif %}
          <a href="/profile/resumes/{{ resume.id }}/download" class="text-brand-primary hover:underline">Download</a>
          {% if not resume.isPrimary %}
            <form method="post" action="/profile/resumes/{{ resume.id }}/primary" hx-post="/profile/resumes/{{ resume.id }}/primary" hx-target="#resumes-list" hx-swap="outerHTML">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <button type="submit" class="text-brand-primary hover:underline">Make primary</button>
            </form>
          {% endif %}
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-4 text-xs">
        <details>
          <summary class="cursor-pointer text-brand-primary">Rename</summary>
          <form method="post" action="/profile/resumes/{{ resume.id }}/name" class="mt-2 flex gap-2" hx-post="/profile/resumes/{{ resume.id }}/name" hx-target="#resumes-list" hx-swap="outerHTML">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label for="resume-name-{{ resume.id }}" class="sr-only">Resume name</label>
            <input id="resume-name-{{ resume.id }}" name="fileName" value="{{ resume.fileName }}" required maxlength="255" class="rounded border border-brand-text/20 px-2 py-1" />
            <button type="submit" class="text-brand-primary">Save</button>
          </form>
        </details>
        {% if resume.parseStatus == 'failed' %}
          <form method="post" action="/profile/resumes/{{ resume.id }}/retry" hx-post="/profile/resumes/{{ resume.id }}/retry" hx-target="#resumes-list" hx-swap="outerHTML">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><button type="submit" class="text-brand-primary">Retry parsing</button>
          </form>
        {% endif %}
        <details>
          <summary class="cursor-pointer text-red-600">Remove</summary>
          <form method="post" action="/profile/resumes/{{ resume.id }}/delete" class="mt-2" hx-post="/profile/resumes/{{ resume.id }}/delete" hx-target="#resumes-list" hx-swap="outerHTML">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button type="submit" class="text-red-600">Confirm permanent removal</button>
          </form>
        </details>
      </div>
      {% if resume.parseError %}<p class="mt-2 text-xs text-red-600">{{ resume.parseError }}</p>{% endif %}
    </article>
  {% else %}
    <p class="text-sm text-brand-text/50">No resumes uploaded yet.</p>
  {% endfor %}
</div>
