{% from "components/button.njk" import button %}
{% if profile.parseStatus == "failed" %}
  <div class="rounded-lg border border-red-200 bg-red-50 p-8 text-center">
    <h1 class="text-xl font-semibold text-red-700">We couldn't read that file</h1>
    <p class="mt-1 text-sm text-red-700/80">{{ profile.parseError or "Something went wrong while reading your CV. Please try again." }}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <form method="post" action="/onboarding/resume/retry" hx-post="/onboarding/resume/retry" hx-target="#onboarding-step" hx-swap="innerHTML">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{ button("Try again", { type: "submit" }) }}
      </form>
      <a href="/onboarding/steps/1" hx-get="/onboarding/steps/1" hx-target="#onboarding-step" hx-swap="innerHTML" class="rounded-md border border-brand-text/20 px-4 py-2 text-sm font-medium hover:bg-brand-text/5">Upload a different file</a>
    </div>
  </div>
{% else %}
  <div class="rounded-lg border border-brand-primary/20 bg-white p-8 text-center" hx-get="/onboarding/resume/status" hx-trigger="every 2s" hx-target="#onboarding-step" hx-swap="innerHTML">
    <h1 class="text-xl font-semibold text-brand-text">Reading your CV…</h1>
    <p class="mt-1 text-sm text-brand-text/60">This usually takes a few seconds. You can safely return to this page later.</p>
    <div class="mt-6 space-y-3" aria-label="Parsing in progress">
      <div class="h-3 animate-pulse rounded bg-brand-text/10"></div>
      <div class="h-3 w-5/6 animate-pulse rounded bg-brand-text/10"></div>
      <div class="h-3 w-2/3 animate-pulse rounded bg-brand-text/10"></div>
    </div>
  </div>
{% endif %}
