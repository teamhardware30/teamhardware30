<div
  class="rounded-lg border border-brand-primary/20 bg-white p-8 text-center"
  hx-get="/onboarding/resume/status"
  hx-trigger="every 2s"
  hx-target="#onboarding-step"
  hx-swap="innerHTML"
>
  <h1 class="text-xl font-semibold text-brand-text">Reading your CV…</h1>
  <p class="mt-1 text-sm text-brand-text/60">This usually takes a few seconds.</p>
  <div class="mt-6 space-y-3">
    <div class="h-3 animate-pulse rounded bg-brand-text/10"></div>
    <div class="h-3 w-5/6 animate-pulse rounded bg-brand-text/10"></div>
    <div class="h-3 w-2/3 animate-pulse rounded bg-brand-text/10"></div>
  </div>
</div>
