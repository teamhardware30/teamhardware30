{% from "components/button.njk" import button %}
{% if profile.parseStatus == "failed" %}
  <div class="rounded-lg border border-red-200 bg-red-50 p-8 text-center">
    <h1 class="text-xl font-semibold text-red-700">We couldn't read that file</h1>
    <p class="mt-1 text-sm text-red-700/80">
      {{ profile.parseError or "Something went wrong while reading your CV. Please try again." }}
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <button
        type="button"
        hx-post="/onboarding/resume/retry"
        hx-target="#onboarding-step"
        hx-swap="innerHTML"
        hx-headers='{"x-csrf-token": "{{ csrfToken }}"}'
        class="rounded-md bg-brand-primary px-4 py-2 text-sm font-medium text-white hover:bg-brand-primary/90"
      >Try again</button>
      <button
        type="button"
        hx-get="/onboarding/steps/1"
        hx-target="#onboarding-step"
        hx-swap="innerHTML"
        class="rounded-md border border-brand-text/20 px-4 py-2 text-sm font-medium hover:bg-brand-text/5"
      >Upload a different file</button>
    </div>
  </div>
{% else %}
  <div
    class="rounded-lg border border-brand-primary/20 bg-white p-8 text-center"
    hx-get="/onboarding/resume/status"
    hx-trigger="every 2s"
    hx-target="#onboarding-step"
    hx-swap="innerHTML"
  >
    <h1 class="text-xl font-semibold text-brand-text">Reading your CV…</h1>
    <p class="mt-1 text-sm text-brand-text/60">This usually takes a few seconds.</p>
    <div class="mt-6 space-y-3">
      <div class="h-3 animate-pulse rounded bg-brand-text/10"></div>
      <div class="h-3 w-5/6 animate-pulse rounded bg-brand-text/10"></div>
      <div class="h-3 w-2/3 animate-pulse rounded bg-brand-text/10"></div>
    </div>
  </div>
{% endif %}
