<div id="skill-suggestions" class="absolute z-10 mt-1 w-full rounded-md border border-brand-text/10 bg-white shadow-lg">
  {% for skill in suggestions %}
    <form method="post" action="/onboarding/skills" hx-post="/onboarding/skills" hx-target="#skill-chips" hx-swap="outerHTML">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="name" value="{{ skill.name }}" />
      <input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
      <button type="submit" class="block w-full px-3 py-2 text-left text-sm hover:bg-brand-primary/5">{{ skill.name }}{% if skill.needsReview %} <span class="text-xs text-amber-700">(review)</span>{% endif %}</button>
    </form>
  {% else %}
    <p class="px-3 py-2 text-sm text-brand-text/50">No matches — press enter to add it as a new skill.</p>
  {% endfor %}
</div>
