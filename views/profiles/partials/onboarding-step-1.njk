{% from "components/button.njk" import button %}
{% from "components/toast.njk" import toast %}

<div>
  <h1 class="text-xl font-semibold text-brand-text">Upload your CV</h1>
  <p class="mt-1 text-sm text-brand-text/60">PDF, DOCX, or a LinkedIn data export (.zip) — up to 5 MB.</p>

  {% if fieldErrors.resume %}
    <div class="mt-4">{{ toast("error", fieldErrors.resume) }}</div>
  {% endif %}

  <form
    class="mt-6 space-y-4 rounded-lg border border-dashed border-brand-primary/30 bg-white p-8 text-center"
    hx-post="/onboarding/resume"
    hx-target="#onboarding-step"
    hx-swap="innerHTML"
    hx-encoding="multipart/form-data"
  >
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <input type="file" name="resume" accept=".pdf,.docx,.zip" required class="mx-auto block text-sm" />
    {{ button("Upload and continue", { type: "submit" }) }}
  </form>
</div>
