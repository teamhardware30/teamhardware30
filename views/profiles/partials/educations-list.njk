<div id="educations-list" class="space-y-3">
  {% for edu in educations %}
    <div class="flex items-start justify-between rounded-md border border-brand-text/10 bg-white p-3">
      <div>
        <p class="text-sm font-medium text-brand-text">{{ edu.degree or "Studies" }} · {{ edu.school }}</p>
        <p class="text-xs text-brand-text/60">
          {{ edu.fieldOfStudy }}
          {% if edu.startDate or edu.endDate %} · {{ edu.startDate or "—" }} – {{ edu.endDate or "—" }}{% endif %}
        </p>
      </div>
      <button
        type="button"
        hx-delete="/onboarding/educations/{{ edu.id }}"
        hx-target="#educations-list"
        hx-swap="outerHTML"
        class="text-xs text-red-600 hover:underline"
      >Remove</button>
    </div>
  {% else %}
    <p class="text-sm text-brand-text/50">No education added yet.</p>
  {% endfor %}
</div>
