{% from "components/button.njk" import button %}
{% from "profiles/partials/education-fields.njk" import education_fields %}
<div id="educations-list" class="space-y-3">
  {% for edu in educations %}
    <article class="rounded-md border border-brand-text/10 bg-white p-3">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-brand-text">{{ edu.degree or "Studies" }} · {{ edu.school }}</p>
          <p class="text-xs text-brand-text/60">{{ edu.fieldOfStudy }}{% if edu.startDate or edu.endDate %} · {{ edu.startDate or "—" }} – {{ edu.endDate or "—" }}{% endif %}</p>
        </div>
        <form method="post" action="/onboarding/educations/{{ edu.id }}/delete" hx-post="/onboarding/educations/{{ edu.id }}/delete" hx-target="#educations-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="text-xs text-red-600 hover:underline">Remove</button>
        </form>
      </div>
      {% if edu.description %}<p class="mt-2 whitespace-pre-line text-sm text-brand-text/70">{{ edu.description }}</p>{% endif %}
      <div class="mt-2 flex gap-2">
        <form method="post" action="/onboarding/educations/{{ edu.id }}/move" hx-post="/onboarding/educations/{{ edu.id }}/move" hx-target="#educations-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="direction" value="-1" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="rounded border border-brand-text/20 px-2 py-1 text-xs" aria-label="Move {{ edu.school }} earlier">↑</button>
        </form>
        <form method="post" action="/onboarding/educations/{{ edu.id }}/move" hx-post="/onboarding/educations/{{ edu.id }}/move" hx-target="#educations-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="direction" value="1" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="rounded border border-brand-text/20 px-2 py-1 text-xs" aria-label="Move {{ edu.school }} later">↓</button>
        </form>
      </div>
      <details class="mt-3" {% if editingEducationId == edu.id %}open{% endif %}>
        <summary class="cursor-pointer text-xs text-brand-primary">Edit education</summary>
        <form method="post" action="/onboarding/educations/{{ edu.id }}" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2" hx-post="/onboarding/educations/{{ edu.id }}" hx-target="#educations-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          {{ education_fields(edu, fieldErrors or {}, 'education-' ~ edu.id ~ '-') }}
          <div class="sm:col-span-2">{{ button("Save changes", { type: "submit" }) }}</div>
        </form>
      </details>
    </article>
  {% else %}
    <p class="text-sm text-brand-text/50">No education added yet.</p>
  {% endfor %}
</div>
