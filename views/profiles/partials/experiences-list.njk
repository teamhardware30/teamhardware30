{% from "components/button.njk" import button %}
{% from "profiles/partials/experience-fields.njk" import experience_fields %}
<div id="experiences-list" class="space-y-3">
  {% for exp in experiences %}
    <article class="rounded-md border border-brand-text/10 bg-white p-3">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-brand-text">{{ exp.title }} · {{ exp.company }}</p>
          <p class="text-xs text-brand-text/60">{{ exp.startDate or "—" }} – {{ "Present" if exp.current else (exp.endDate or "—") }}{% if exp.location %} · {{ exp.location }}{% endif %}</p>
        </div>
        <form method="post" action="/onboarding/experiences/{{ exp.id }}/delete" hx-post="/onboarding/experiences/{{ exp.id }}/delete" hx-target="#experiences-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="text-xs text-red-600 hover:underline">Remove</button>
        </form>
      </div>
      {% if exp.description %}<p class="mt-2 whitespace-pre-line text-sm text-brand-text/70">{{ exp.description }}</p>{% endif %}
      <div class="mt-2 flex gap-2">
        <form method="post" action="/onboarding/experiences/{{ exp.id }}/move" hx-post="/onboarding/experiences/{{ exp.id }}/move" hx-target="#experiences-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="direction" value="-1" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="rounded border border-brand-text/20 px-2 py-1 text-xs" aria-label="Move {{ exp.title }} earlier">↑</button>
        </form>
        <form method="post" action="/onboarding/experiences/{{ exp.id }}/move" hx-post="/onboarding/experiences/{{ exp.id }}/move" hx-target="#experiences-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="direction" value="1" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          <button type="submit" class="rounded border border-brand-text/20 px-2 py-1 text-xs" aria-label="Move {{ exp.title }} later">↓</button>
        </form>
      </div>
      <details class="mt-3" {% if editingExperienceId == exp.id %}open{% endif %}>
        <summary class="cursor-pointer text-xs text-brand-primary">Edit experience</summary>
        <form method="post" action="/onboarding/experiences/{{ exp.id }}" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2" hx-post="/onboarding/experiences/{{ exp.id }}" hx-target="#experiences-list" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" /><input type="hidden" name="returnTo" value="{{ returnTo or '/onboarding' }}" />
          {{ experience_fields(exp, fieldErrors or {}, 'experience-' ~ exp.id ~ '-') }}
          <div class="sm:col-span-2">{{ button("Save changes", { type: "submit" }) }}</div>
        </form>
      </details>
    </article>
  {% else %}
    <p class="text-sm text-brand-text/50">No experience added yet.</p>
  {% endfor %}
</div>
